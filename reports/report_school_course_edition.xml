<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Informes QWeb per a School Course -->
        <record id="action_qweb_report_course_editions" model="ir.actions.report">
            <field name="name">Course Editions Report</field>
            <field name="model">school.course</field>
            <field name="report_type">qweb-pdf</field>
            <!--school.report_course_card_template per a l'Isidre-->
            <field name="report_name">school.report_course_editions_template</field>
            <field name="report_file">school.report_course_editions_template</field>
            <field name="model_id" ref="school.model_school_course" /> <!--Necessita obligatoriament la paraula model aquí-->
            <field name="binding_model_id" ref="school.model_school_course" />
            <field name="binding_type">report</field>
        </record>

        <template id="report_course_editions_template">
            <t t-call="web.html_container">
                <t t-foreach="iteration" t-as="obj">
                    <t t-call="web.external_layout">
                        <div>
                            <div class="text-end">
                                <!--TODO-->

                            </div>
                        </div>
                    </t>
                </t>
            </t>
        </template>
    </data>
</odoo>