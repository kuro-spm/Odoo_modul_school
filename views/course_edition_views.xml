<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record model="ir.ui.view" id="school_course_edition_calendar">
        <field name="name">school.course.edition.calendar</field>
        <field name="model">school.course.edition</field>
        <field name="arch" type="xml">
            <calendar date_start="date_start" date_stop="date_stop" mode="month" create="0" delete="0" edit="0">
                <field name="course_id" />
                <field name="name" string="Edition name" />
                <field name="n_teachers" string="Teachers count" />
            </calendar>
        </field>
    </record>

    <!--en prémer "Modificar", el formulari ha de mostrar la informació i no permetre duplicar ni eliminar...-->
    <!--Això es controla amb els atributs duplicate="0" i delete="0" a l'etiqueta <form>-->
    <record model="ir.ui.view" id="school_course_edition_form_calendar">
        <field name="name">school.course.edition.form.calendar</field>
        <field name="model">school.course.edition</field>
        <field name="arch" type="xml">
            <form string="Edition" create="0" duplicate="0" delete="0" edit="0">
                <sheet>
                    <group>
                        <field name="course_id" readonly="1" />
                        <field name="name" />
                        <field name="date_start" />
                        <field name="date_stop" />
                        <field name="n_teachers" readonly="1" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>
</odoo>