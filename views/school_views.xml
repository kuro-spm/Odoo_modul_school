<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!--views-->
    <record model="ir.ui.view" id="school_course_list">
        <field name="name">school.course.list</field>
        <field name="model">school.course</field>
        <field name="arch" type="xml">
            <list string="Courses"> <!--Compte! posar editable="top" converteix la llista en editable però no podrem accedir al formulari...-->
                <field name="name" />
                <field name="hours" />
                <!--invisible="name>'E'"-->
                <!--PROVES: És invisible si el nom comença per una lletra major a la E-->
                <field name="manager_id" />
                <field name="thematic_id" />
            </list>
        </field>
    </record>

    <record model="ir.ui.view" id="school_course_form">
        <field name="name">school.course.form</field>
        <field name="model">school.course</field>
        <field name="arch" type="xml">
            <form string="Course">
                <sheet>
                    <group col="4">
                        <group colspan="2">
                            <field name="name" />
                            <field name="thematic_id" />
                            <field name="manager_id" />
                            <field name="hours" />
                        </group>
                        <group colspan="2">
                            <label for="summary" string="Summary"></label>
                            <field name="summary" nolabel="1" editable="1" colspan="2"></field>
                        </group>
                    </group>

                    <!--<group colspan="2" col="2"> <separator string="Dades creació" /> <field string="Usuari" name="create_uid" /> <field string="Moment temporal" name="create_date" /> </group> <group colspan="2" col="2"> <separator string="Darrera modificació" /> <field string="Usuari" name="write_uid" /> <field string="Moment temporal" name="write_date" /> </group>-->

                    <!--S'han de poder veure/assignar/crear assignatures en school_course_form-->
                    <!--Des del formulari de SchoolCourse s’ha de poder continuar amb la gestió (altes-baixesconsultes-modificacions) de les seves assignatures, però ara, des de SchoolCourse no s’accedeix a SchoolSubject, sinó a SchoolCourseSubject i, per tant, els camps a mostrar no són els de SchoolSubject. I cal mostrar el número que ocupa dins el curs i el nom de l’assignatura.-->
                    <group col="4">
                        <group string="Subjects" colspan="2">
                            <field name="course_subject_ids" nolabel="1" readonly="0">
                                <list>
                                    <!--Com que hem canviat subject_ids per course_subject_ids, això ja no ens cal...-->
                                    <!--<field name="name" /> <field name="hours" />-->
                                    <field name="number" />
                                    <field name="subject_id" />
                                </list>
                                <!--<form> <group> <field name="name" /> <field name="hours" /> </group> </form>-->
                            </field>
                        </group>

                        <group string="Course Calls" colspan="2">
                            <field name="course_call_ids" nolabel="1" readonly="0">
                                <list>
                                    <field name="name" />
                                    <field name="date_start" />
                                    <field name="date_finish" />
                                </list>
                            </field>
                        </group>
                    </group>

                </sheet>
            </form>
        </field>
    </record>

    <record model="ir.ui.view" id="school_subject_list">
        <field name="name">school.subject.list</field>
        <field name="model">school.subject</field>
        <field name="arch" type="xml">
            <list string="Subjects">
                <field name="name" />
                <field name="hours" />
                <field name="create_uid" optional="show" />
                <field name="create_date" optional="show" />
                <field name="write_uid" optional="hide" />
                <field name="write_date" optional="hide" />
            </list>
        </field>
    </record>


    <record model="ir.ui.view" id="school_subject_form">
        <field name="name">school.subject.form</field>
        <field name="model">school.subject</field>
        <field name="arch" type="xml">
            <form string="Subject">
                <sheet>
                    <group><!-- col="4"-->
                        <group><!--colspan="3"-->
                            <field name="name" placeholder="Write subject's name..." />
                            <field name="hours" placeholder="???" />
                        </group>

                        <!--En el formulari d’assignatures es pugui veure els cursos on apareix, però no assignar/crear/eliminar cursos-->
                        <group string="Courses"><!-- colspan="1"-->
                            <field name="course_subject_ids" nolabel="1" readonly="1">
                                <!--Com que hem canviat course_ids per course_subject_ids, això ja no ens cal...-->
                                <!--<list create="0" delete="0"> <field name="name" /> <field name="hours" /> </list>-->
                                <list>
                                    <field name="number" />
                                    <field name="course_id" />
                                </list>
                            </field>
                        </group>
                        <!--En el formulari d’assignatures es pugui veure el professorat que la pot impartir, però sense assignar/crear/eliminar professorat.-->
                        <group string="Authorized Teachers">
                            <field name="teacher_ids" nolabel="1" readonly="1">
                                <list create="0" delete="0">
                                    <field name="display_name" />
                                    <field name="email" />
                                </list>
                            </field>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record model="ir.ui.view" id="school_teacher_list">
        <field name="name">school.teacher.list</field>
        <field name="model">school.teacher</field>
        <field name="arch" type="xml">
            <list string="Teachers">
                <field name="photo" widget="image" options="{'size': [40, 40]}" />
                <!--<field name="first_name" /> <field name="last_name" />-->
                <field name="display_name" string="Full name" />
                <field name="birthdate" />
                <field name="tin" />
                <field name="gender" />
                <field name="salary" />
                <field name="email" />
                <field name="phone" />
                <!--Amb One2Many ara podem veure els cursos de cada professor-->
                <field name="course_ids" optional="hide" />
            </list>
        </field>
    </record>


    <record model="ir.ui.view" id="view_teacher_form">
        <field name="name">school.teacher.form</field>
        <field name="model">school.teacher</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <field name="photo" widget="image" class="oe_avatar" />
                    <group>
                        <group string="Personal data" col="8">
                            <field name="first_name" colspan="8" placeholder="???" required="True" />
                            <field name="last_name" colspan="8" placeholder="???" required="True" />
                            <field name="birthdate" colspan="4" placeholder="???" required="True" />
                            <field name="age" colspan="4" col="4" placeholder="???" editable="0" />
                            <field name="gender" colspan="8" placeholder="???" />
                        </group>
                        <group string="Other data" col="4">
                            <field name="email" widget="email" placeholder="???" colspan="4" required="True" />
                            <field name="phone" placeholder="???" required="0" colspan="2" />
                            <field name="country_id" required="True" placeholder="???" colspan="2" />
                            <field name="tin" placeholder="???" colspan="2" />
                            <field name="salary" placeholder="???" colspan="2" />
                        </group>
                    </group>
                    <notebook>
                        <!--TUTTURU~-->
                        <page name="courses" string="Courses">
                            <group>
                                <group string="Managed Courses">
                                    <field name="course_ids" readonly="0" nolabel="1" widget="many2many" context="{'default_manager_id': id}">
                                        <!--Si no definim una list aqui, surten tots els camps de la primera list de cursos que trobi.-->
                                        <list>
                                            <field name="name" />
                                            <field name="hours" />
                                            <field name="thematic_id" />
                                        </list>
                                        <!--Perquè no surti el formulari per defecte en crear un nou curs, hem de crear un formulari personalitzat-->
                                        <form>
                                            <group col="4">
                                                <field name="name" colspan="2" />
                                                <field name="hours" />
                                                <field name="thematic_id" />
                                            </group>
                                        </form>
                                    </field>
                                </group>

                                <group></group> <!--Per a que ocupi mitja pantalla-->
                            </group>
                        </page>

                        <page name="subjects" string="Subjects">
                            <group>
                                <group string="Authorized Subjects">
                                    <field name="subject_ids" nolabel="1" readonly="0">
                                        <!--Si no definim una list aqui, surten tots els camps de la primera list d'assignatures que trobi.-->
                                        <list create="0" delete="0">
                                            <field name="name" />
                                            <field name="hours" />
                                        </list>
                                    </field>
                                </group>
                                <group></group> <!--Per a que ocupi mitja pantalla-->
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record model="ir.ui.view" id="school_thematic_list">
        <field name="name">school.thematic.list</field>
        <field name="model">school.thematic</field>
        <field name="arch" type="xml">
            <list string="Thematics" editable="top">
                <field name="name" />
                <field name="parent_id" />
                <field name="child_ids" />
                <field name="course_ids" />
            </list>
        </field>
    </record>

    <record model="ir.ui.view" id="school_thematic_form">
        <field name="name">school.thematic.form</field>
        <field name="model">school.thematic</field>
        <field name="arch" type="xml">
            <form string="Thematic">
                <sheet>
                    <group colspan="2">
                        <group colspan="2">
                            <field name="name" />
                            <field name="parent_id" />
                        </group>
                        <group string="Child Thematics">
                            <field name="child_ids" nolabel="1" colspan="2">
                                <list>
                                    <field name="name" />
                                </list>
                            </field>
                        </group>
                        <group string="Courses">
                            <field name="course_ids" nolabel="1" colspan="2">
                                <list>
                                    <field name="name" />
                                    <field name="hours" />
                                    <field name="manager_id" />
                                </list>
                            </field>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!--Actions-->
    <record model="ir.actions.act_window" id="school_course_action">
        <!--és la action per invocar el contingut dels cursos-->
        <field name="name">Courses</field>
        <field name="res_model">school.course</field>
        <field name="view_mode">list,form</field>
        <!--Si encara no hem fet la vista 'form', Odoo crea una per defecte!!!-->
    </record>

    <record model="ir.actions.act_window" id="school_subject_action">
        <field name="name">Subjects</field>
        <field name="res_model">school.subject</field>
        <field name="view_mode">list,form</field>
    </record>

    <record model="ir.actions.act_window" id="school_teacher_action">
        <field name="name">Teachers</field>
        <field name="res_model">school.teacher</field>
        <field name="view_mode">list,form</field>
    </record>

    <record model="ir.actions.act_window" id="school_thematic_action">
        <field name="name">Thematic</field>
        <field name="res_model">school.thematic</field>
        <field name="view_mode">list,form</field>
    </record>


    <!--Menus-->
    <!--Primer creem el menú principal-->
    <menuitem name="School" id="menu_root" />
    <!--Resta de menus-->
    <menuitem name="Configuration" id="menu_configuration" parent="menu_root" sequence="99" />

    <menuitem name="Courses" id="menu_courses" parent="menu_configuration"
        action="school_course_action" />

    <menuitem name="Subjects" id="menu_subjects" parent="menu_configuration"
        action="school_subject_action" />

    <menuitem name="Thematic" id="menu_thematic" parent="menu_configuration"
        action="school_thematic_action" />

    <menuitem name="Teachers" id="menu_teachers" parent="menu_root" sequence="50"
        action="school_teacher_action" />

</odoo>