<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record model="ir.ui.view" id="school_teacher_salary_history_list">
        <field name="name">school.teacher.salary.history.tree</field>
        <field name="model">school.teacher.salary.history</field>
        <field name="arch" type="xml">
            <list string="Salary History" create="0" delete="0">
                <field name="teacher_id" />
                <field name="user_id" />
                <field name="date" />
                <field name="time_s" />
                <field name="time_f" widget="float_time" />
                <field name="salary" />
            </list>
        </field>
    </record>

    <record model="ir.actions.act_window" id="school_teacher_salary_history_action">
        <field name="name">Teacher Salary History</field>
        <field name="res_model">school.teacher.salary.history</field>
        <field name="view_mode">list</field>
    </record>

    <menuitem name="Teacher Salary History" id="menu_teacher_salary_history" parent="menu_configuration" sequence="99"
        action="school_teacher_salary_history_action" />

</odoo>