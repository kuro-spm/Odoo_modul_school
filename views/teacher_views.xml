<?xml version="1.0" encoding="utf-8"?>
<odoo>


    <record model="ir.ui.view" id="school_teacher_list">
        <field name="name">school.teacher.list</field>
        <field name="model">school.teacher</field>
        <field name="arch" type="xml">
            <list string="Teachers" decoration-danger="active==False" decoration-success="active==True">
                <field name="photo" widget="image" options="{'size': [40, 40]}" />
                <!--<field name="first_name" /> <field name="last_name" />-->
                <field name="display_name" string="Full name" />
                <field name="birthdate" />
                <field name="tin" />
                <field name="gender" />
                <field name="salary" />
                <field name="email" />
                <field name="phone" />
                <!--Amb la One2Many ara podem veure els cursos de cada professor-->
                <field name="course_ids" optional="hide" />
                <!--Amb els nous camps computed podem veure el núm de cursos, teachings i assignatures del professor-->
                <field name="n_managed" optional="show" />
                <field name="n_teaching" optional="show" />
                <field name="n_subjects" optional="show" />

            </list>
        </field>
    </record>


    <record model="ir.ui.view" id="view_teacher_form">
        <field name="name">school.teacher.form</field>
        <field name="model">school.teacher</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <field name="photo" widget="image" class="oe_avatar" />
                    <group>
                        <group string="Personal data" col="8">
                            <field name="first_name" colspan="8" placeholder="???" required="True" />
                            <field name="last_name" colspan="8" placeholder="???" required="True" />
                            <field name="birthdate" colspan="4" placeholder="???" required="True" />
                            <field name="age" colspan="4" col="4" placeholder="???" editable="0" />
                            <field name="gender" colspan="8" placeholder="???" />
                        </group>
                        <group string="Other data" col="4">
                            <!--Per l'email utilitzem widget="email"-->
                            <field name="email" widget="email" placeholder="???" colspan="4" required="True" />
                            <field name="phone" placeholder="???" required="0" colspan="2" />
                            <field name="country_id" required="True" placeholder="???" colspan="2" />
                            <field name="tin" placeholder="???" colspan="2" />
                            <field name="salary" placeholder="???" colspan="2" />
                        </group>
                    </group>
                    <notebook>
                        <!--TUTTURU~-->
                        <page name="courses" string="Managed Courses">
                            <group> <!-- Aquest grup ocupa les 4 columnes de la pantalla-->
                                <group string="Managed Courses"> <!-- Aquest grup ocupa 2 columnes de les 4 => Mitja pantalla -->
                                    <field name="course_ids" readonly="0" nolabel="1" widget="many2many"><!--context="{'default_manager_id': id}"-->
                                        <!--Si no definim una list aqui, surten tots els camps de la primera list de cursos que trobi.-->
                                        <list create="0" decoration-danger="active==False">
                                            <field name="name" />
                                            <field name="hours" />
                                        </list>
                                        <!--Perquè no surti el formulari per defecte en crear un nou curs, hem de crear un formulari personalitzat-->
                                        <form>
                                            <group col="4">
                                                <field name="name" colspan="2" />
                                                <field name="hours" />
                                            </group>
                                        </form>
                                    </field>
                                </group>
                            </group>
                        </page>

                        <page name="subjects" string="Subjects">
                            <group> <!-- Aquest grup ocupa les 4 columnes de la pantalla-->
                                <group string="Authorized Subjects"> <!-- Aquest grup ocupa 2 columnes de les 4 => Mitja pantalla -->
                                    <field name="subject_ids" nolabel="1" readonly="0">
                                        <!--Si no definim una list aqui, surten tots els camps de la primera list d'assignatures que trobi.-->
                                        <list create="0" delete="0" decoration-danger="active==False">
                                            <field name="name" />
                                            <field name="hours" />
                                        </list>
                                    </field>
                                </group>
                                <group>
                                    <!--Perquè ocupi mitja pantalla?-->
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record model="ir.ui.view" id="school_teacher_graph">
        <field name="name">school.teacher.graph</field>
        <field name="model">school.teacher</field>
        <field name="arch" type="xml">
            <graph string="Teachers" type="bar">
                <field name="tin" />
                <field name="salary" type="measure" />
            </graph>
        </field>
    </record>

    <record model="ir.ui.view" id="school_teacher_calendar">
        <field name="name">school.teacher.calendar</field>
        <field name="model">school.teacher</field>
        <field name="arch" type="xml">
            <calendar date_start="birthday" mode="month" create="0" delete="0">
                <field name="display_name" />
                <field name="birthday_age" />
            </calendar>
        </field>
    </record>

    <record model="ir.ui.view" id="school_teacher_search">
        <field name="name">school.teacher.search</field>
        <field name="model">school.teacher</field>
        <field name="arch" type="xml">
            <search string="Search Teacher">
                <!-- Camps per a cerca manual -->
                <field name="last_name" />
                <field name="tin" />
                <field name="birthdate" />
                <!-- Filtres que apareixen a l'apartat "Filtres" -->
                <filter name="female" string="Female" domain="[('gender','=','female')]" />
                <filter name="male" string="Male" domain="[('gender','=','male')]" />
                <separator />
                <filter name="salary+" string="Salary &gt;=3000" domain="[('salary','&gt;=',3000)]" />
                <filter name="salary-" string="Salary &lt;3000" domain="[('salary','&lt;',3000)]" />
                <separator />
                <filter name="active" string="Active" domain="[('active','=',True)]" />
                <filter name="inactive" string="Archived" domain="[('active','=',False)]" />
                <!-- Filtres que apareixen a l'apartat "Agrupar per" -->
                <filter name="g_active" string="Active" context="{'group_by':'active'}" />
                <separator />
                <filter name="gender" string="Gender" domain="[]" context="{'group_by':'gender'}" />
            </search>
        </field>
    </record>

</odoo>